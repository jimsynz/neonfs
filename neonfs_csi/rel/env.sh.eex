#!/bin/sh

# Release environment configuration for neonfs_csi

# Set default node name if not provided
if [ -z "$RELEASE_NODE" ]; then
  export RELEASE_NODE="neonfs_csi@$(hostname -f 2>/dev/null || hostname)"
fi

# Set core node to connect to
if [ -z "$NEONFS_CORE_NODE" ]; then
  export NEONFS_CORE_NODE="neonfs_core@$(hostname -f 2>/dev/null || hostname)"
fi

# The cookie is a constant, non-secret value: distribution security comes
# from mutual TLS (cluster-CA-issued certificates), not the cookie.
export RELEASE_COOKIE="neonfs"

# Enable distribution (required for communication with core)
export RELEASE_DISTRIBUTION="${NEONFS_DISTRIBUTION:-name}"
export RELEASE_NODE_SUFFIX=""

# Custom EPMD module: no external EPMD daemon needed
export ELIXIR_ERL_OPTIONS="${ELIXIR_ERL_OPTIONS} -start_epmd false -epmd_module Elixir.NeonFS.Epmd"

# TLS distribution: encrypt all Erlang distribution traffic.
#
# Refusing to boot without it is deliberate. Silently omitting `-proto_dist
# inet_tls` left a pod running plain distribution with the constant, public
# cookie — it came up, never connected to anything, and had nothing in its logs
# pointing at why. A CrashLoopBackOff naming the missing file is a worse-looking
# but far cheaper failure, and a driver that cannot authenticate to the cluster
# is not serving volumes either way.
#
# `NEONFS_ALLOW_INSECURE_DIST=1` opts out, for a single-node development release
# that never joins a cluster.
NEONFS_TLS_DIR="${NEONFS_TLS_DIR:-/var/lib/neonfs/tls}"
if [ -f "${NEONFS_TLS_DIR}/ssl_dist.conf" ]; then
  export ELIXIR_ERL_OPTIONS="${ELIXIR_ERL_OPTIONS} -proto_dist inet_tls -ssl_dist_optfile ${NEONFS_TLS_DIR}/ssl_dist.conf"
elif [ "${NEONFS_ALLOW_INSECURE_DIST:-0}" = "1" ]; then
  echo "neonfs_csi: NEONFS_ALLOW_INSECURE_DIST=1 — starting without TLS distribution" >&2
else
  echo "neonfs_csi: no ssl_dist.conf in ${NEONFS_TLS_DIR}; this host has no cluster identity." >&2
  echo "neonfs_csi: an init container should have redeemed an invite into it — check its logs" >&2
  echo "neonfs_csi: and that ${NEONFS_TLS_DIR} is mounted. Set NEONFS_ALLOW_INSECURE_DIST=1 to" >&2
  echo "neonfs_csi: start anyway, which cannot reach a cluster." >&2
  exit 1
fi
