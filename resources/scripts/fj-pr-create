#!/usr/bin/env bash
# Open a pull request.
#
# Usage: fj-pr-create <head-branch> <title> <body|-> [base-branch]
#
# Body may be "-" to read from stdin (preferred for multi-line markdown).
# Base branch defaults to "main".
# Prints the new PR number on success.

source "$(dirname "$(readlink -f "$0")")/_fj-lib.sh"

head="${1:-}"
title="${2:-}"
body_arg="${3:-}"
base="${4:-main}"
[ -n "$head" ] && [ -n "$title" ] && [ -n "$body_arg" ] || \
  fj_die "usage: fj-pr-create <head-branch> <title> <body|-> [base-branch]"

if [ "$body_arg" = "-" ]; then
  body=$(cat)
else
  body="$body_arg"
fi

payload=$(jq -nc \
  --arg title "$title" \
  --arg body  "$body" \
  --arg head  "$head" \
  --arg base  "$base" \
  '{title: $title, body: $body, head: $head, base: $base}')

# A PR is identified by its head branch, which is exact — unlike an issue's
# title. Forgejo also rejects a duplicate for the same head/base with a 4xx,
# so this path was already hard to duplicate; verifying makes that a property
# of the script rather than of the server's uniqueness check.
find_pr_by_head() {
  fj_json GET "/pulls?state=open&limit=50" \
    | jq -r --arg h "$head" '[.[] | select(.head.ref == $h)] | max_by(.number) | .number // empty'
}

fj_create "/pulls" "$payload" find_pr_by_head
