#!/usr/bin/env bash
# Poll a PR's CI until every required context succeeds, then squash-merge.
#
# Usage:
#   fj-pr-merge-when-green <pr-number> [--timeout SECONDS] [--poll SECONDS]
#                                       [--no-merge]
#
#   --timeout  Give up after N seconds (default 3600).
#   --poll     Poll interval in seconds (default 60).
#   --no-merge Stop at "all green", don't actually merge. Useful for the
#              loop's "wait, then human reviews" mode.
#
# Exit codes:
#   0  merged (or all-green if --no-merge)
#   2  PR not mergeable (conflicts) — needs rebase
#   3  one or more contexts failed
#   4  timed out waiting for results
#   5  PR is closed / merged already

source "$(dirname "$(readlink -f "$0")")/_fj-lib.sh"

n="${1:-}"
[ -n "$n" ] || fj_die "usage: fj-pr-merge-when-green <pr-number> [--timeout S] [--poll S] [--no-merge]"
shift

timeout=3600
poll=60
do_merge=1
while [ "$#" -gt 0 ]; do
  case "$1" in
    --timeout) timeout="$2"; shift 2 ;;
    --poll)    poll="$2";    shift 2 ;;
    --no-merge) do_merge=0;  shift   ;;
    *) fj_die "unknown flag: $1" ;;
  esac
done

deadline=$(( $(date +%s) + timeout ))

# `mergeable` is recomputed in the background, so it reads false in the window
# right after a push — which is exactly when this script is invoked, every
# time CI is re-triggered. Treating that as a conflict sent the caller to
# rebase and force-push a branch that was already a strict descendant of
# `main`, cancelling the CI run it was waiting for. Require the flag to stay
# false across a poll before believing it.
unmergeable_polls=0

while :; do
  pr=$(fj_json GET "/pulls/$n")
  state=$(echo "$pr" | jq -r '.state')
  merged=$(echo "$pr" | jq -r '.merged')
  mergeable=$(echo "$pr" | jq -r '.mergeable')
  sha=$(echo "$pr" | jq -r '.head.sha')

  # Guard every field this loop makes a decision on. `fj_json` already
  # rejects a body that will not parse, but a JSON body missing these keys
  # would still yield "null" — and "null" is not "closed". Deciding on one
  # is how this script came to report an open, mid-CI PR as already merged
  # and exit 5, which tells its caller the work is done.
  for field in state merged mergeable sha; do
    if [ -z "${!field}" ] || [ "${!field}" = "null" ]; then
      fj_die "PR #$n: response has no usable .$field — refusing to guess"
    fi
  done

  if [ "$state" != "open" ] || [ "$merged" = "true" ]; then
    echo "PR #$n is $state (merged=$merged) — nothing to do"
    exit 5
  fi

  if [ "$mergeable" != "true" ]; then
    unmergeable_polls=$((unmergeable_polls + 1))

    if [ "$unmergeable_polls" -ge 2 ]; then
      echo "PR #$n is not mergeable (conflicts) — rebase needed"
      exit 2
    fi

    echo "PR #$n reports mergeable=$mergeable — re-checking after ${poll}s" \
         "in case it is still being recomputed"
    sleep "$poll"
    continue
  fi

  unmergeable_polls=0

  statuses=$(fj_statuses "$sha")
  total=$(echo "$statuses" | jq 'length')
  pending=$(echo "$statuses" \
    | jq '[.[] | select(.status == "pending")] | length')
  failing=$(echo "$statuses" \
    | jq '[.[] | select(.status == "failure" or .status == "error")] | length')
  success=$(echo "$statuses" \
    | jq '[.[] | select(.status == "success")] | length')

  echo "PR #$n: $success/$total green, $pending pending, $failing failing"

  if [ "$failing" -gt 0 ]; then
    echo "$statuses" \
      | jq -r '.[] | select(.status == "failure" or .status == "error")
                    | "  ✗ " + .context + " — " + .description'
    exit 3
  fi

  if [ "$pending" -eq 0 ] && [ "$total" -gt 0 ]; then
    echo "all green"
    if [ "$do_merge" = "1" ]; then
      # Not via fj_curl's retry: a merge whose response is lost has still
      # merged, and re-sending it would report a spurious failure. One
      # attempt, then confirm against the PR's own state.
      #
      # `FJ_WRITE_MAX_TIME`, not the read budget: the server does git work
      # here, and on a slow instance that outlasts the budget a status read
      # needs — which surfaces as HTTP 000 and reads as a refusal.
      jq -nc '{Do: "squash"}' \
        | FJ_RETRIES=1 FJ_MAX_TIME="$FJ_WRITE_MAX_TIME" \
            fj_curl POST "/pulls/$n/merge" --data-binary @- > /dev/null \
        || echo "merge request failed or its response was lost — verifying" >&2

      if [ "$(fj_json GET "/pulls/$n" | jq -r '.merged')" = "true" ]; then
        echo "merged #$n"
      else
        fj_die "PR #$n still reports merged=false after the merge request"
      fi
    fi
    exit 0
  fi

  if [ "$(date +%s)" -ge "$deadline" ]; then
    echo "timed out after ${timeout}s with $pending pending, $failing failing"
    exit 4
  fi

  sleep "$poll"
done
