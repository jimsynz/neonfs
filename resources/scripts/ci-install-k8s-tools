#!/usr/bin/env bash
#
# Install the Kubernetes end-to-end toolchain into /usr/local/bin.
#
# The CI base images live in a separate repository, so this provisions
# in-job — the same shape as the csi-sanity build that used to be inlined in
# ci.yml, which this replaces. Every tool is version-pinned here so the pin
# and the cache key can never disagree: a job asks for the version with
# `--print-version` and keys its cache on the answer.
#
# Usage:
#   ci-install-k8s-tools                     # install everything
#   ci-install-k8s-tools kind kubectl        # install a subset
#   ci-install-k8s-tools --print-version helm
#   ci-install-k8s-tools --list
#
# Installing a tool that is already present at the pinned version is a
# no-op, so a restored cache is not rebuilt.

set -euo pipefail

KIND_VERSION="0.30.0"
K3D_VERSION="5.8.3"
KUBECTL_VERSION="1.34.1"
HELM_VERSION="3.19.0"
CSI_SANITY_VERSION="5.4.0"
GO_VERSION="1.23.6"

BIN_DIR="${BIN_DIR:-/usr/local/bin}"

# kind is listed because #1750 names it and it is what a developer reaches
# for locally; the CI job boots k3d, whose k3s node needs no systemd and so
# survives running inside a container's own Docker daemon — kind's node does
# not, and fails with "could not find a log line that matches … Multi-User
# System".
ALL_TOOLS=(kind k3d kubectl helm csi-sanity)

die() {
  echo "ci-install-k8s-tools: $*" >&2
  exit 1
}

version_for() {
  case "$1" in
    kind) echo "$KIND_VERSION" ;;
    k3d) echo "$K3D_VERSION" ;;
    kubectl) echo "$KUBECTL_VERSION" ;;
    helm) echo "$HELM_VERSION" ;;
    csi-sanity) echo "$CSI_SANITY_VERSION" ;;
    *) die "unknown tool: $1" ;;
  esac
}

# The download URLs use Go's naming (amd64/arm64), which is what
# `dpkg --print-architecture` reports on the Debian-based CI images.
arch() {
  if command -v dpkg >/dev/null 2>&1; then
    dpkg --print-architecture
    return
  fi

  case "$(uname -m)" in
    x86_64) echo amd64 ;;
    aarch64) echo arm64 ;;
    *) die "unsupported architecture: $(uname -m)" ;;
  esac
}

download() {
  curl --fail --silent --show-error --location --retry 3 --retry-delay 5 "$@"
}

installed_version() {
  local tool="$1"
  local binary="${BIN_DIR}/${tool}"

  [ -x "$binary" ] || return 1

  case "$tool" in
    kind) "$binary" --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1 ;;
    k3d) "$binary" version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1 ;;
    kubectl) "$binary" version --client 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1 ;;
    helm) "$binary" version --short 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1 ;;
    # csi-sanity reports no version of its own, so its presence is all there
    # is to check; the cache key carries the version instead.
    csi-sanity) version_for csi-sanity ;;
  esac
}

install_kind() {
  download -o "${BIN_DIR}/kind" \
    "https://github.com/kubernetes-sigs/kind/releases/download/v${KIND_VERSION}/kind-linux-$(arch)"
  chmod +x "${BIN_DIR}/kind"
}

install_k3d() {
  download -o "${BIN_DIR}/k3d" \
    "https://github.com/k3d-io/k3d/releases/download/v${K3D_VERSION}/k3d-linux-$(arch)"
  chmod +x "${BIN_DIR}/k3d"
}

install_kubectl() {
  download -o "${BIN_DIR}/kubectl" \
    "https://dl.k8s.io/release/v${KUBECTL_VERSION}/bin/linux/$(arch)/kubectl"
  chmod +x "${BIN_DIR}/kubectl"
}

install_helm() {
  local tmp
  tmp="$(mktemp -d)"

  download -o "${tmp}/helm.tar.gz" \
    "https://get.helm.sh/helm-v${HELM_VERSION}-linux-$(arch).tar.gz"
  tar -C "$tmp" -xzf "${tmp}/helm.tar.gz"
  install -m 0755 "${tmp}/linux-$(arch)/helm" "${BIN_DIR}/helm"

  rm -rf "$tmp"
}

# csi-sanity ships no release binaries, so it is built from source. Go is
# fetched only when this is the tool being installed — every other tool is a
# download.
install_csi_sanity() {
  if [ ! -x /usr/local/go/bin/go ]; then
    download "https://go.dev/dl/go${GO_VERSION}.linux-$(arch).tar.gz" | tar -C /usr/local -xz
  fi

  GOBIN="$BIN_DIR" /usr/local/go/bin/go install \
    "github.com/kubernetes-csi/csi-test/v5/cmd/csi-sanity@v${CSI_SANITY_VERSION}"
}

install_tool() {
  local tool="$1"
  local want
  want="$(version_for "$tool")"

  if [ "$(installed_version "$tool" || true)" = "$want" ]; then
    echo "${tool} ${want} already present"
    return
  fi

  echo "installing ${tool} ${want}"

  case "$tool" in
    kind) install_kind ;;
    k3d) install_k3d ;;
    kubectl) install_kubectl ;;
    helm) install_helm ;;
    csi-sanity) install_csi_sanity ;;
  esac

  [ -x "${BIN_DIR}/${tool}" ] || die "${tool} did not land in ${BIN_DIR}"
  echo "${tool} ${want} installed"
}

main() {
  case "${1:-}" in
    --list)
      printf '%s\n' "${ALL_TOOLS[@]}"
      return
      ;;
    --print-version)
      [ $# -eq 2 ] || die "--print-version takes exactly one tool"
      version_for "$2"
      return
      ;;
  esac

  local tools=("$@")
  [ ${#tools[@]} -gt 0 ] || tools=("${ALL_TOOLS[@]}")

  for tool in "${tools[@]}"; do
    install_tool "$tool"
  done
}

main "$@"
