#!/usr/bin/env bash
# Decide which CI jobs a change needs. Reads changed file paths on stdin
# (one per line, as from `git diff --name-only`) and emits GITHUB_OUTPUT
# lines:
#
#   packages=<JSON array of package names from .forgejo/ci-matrix.json>
#   run_integration=true|false
#   run_cli=true|false
#   run_wire=true|false
#   run_vfs=true|false
#
# `ci-affected --all` selects everything (used for pushes to main).
#
# The mapping encodes the sibling dependency graph, including test-only
# deps (s3→webdav, docker→fuse, integration→cli) and the test_support→core
# coupling that makes most interface suites boot core. Paths that match no
# rule select everything — unknown means unsafe to skip.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
matrix_file="$repo_root/.forgejo/ci-matrix.json"

declare -A affected=()
run_integration=false
run_cli=false
run_wire=false
run_vfs=false
run_all=false
all_packages=false

mark() {
  local unit
  for unit in "$@"; do
    case "$unit" in
      integration) run_integration=true ;;
      cli) run_cli=true ;;
      wire) run_wire=true ;;
      vfs) run_vfs=true ;;
      *) affected[$unit]=1 ;;
    esac
  done
}

classify() {
  case "$1" in
    # Inert: nothing in CI consumes these.
    *.md) ;;
    docs/* | deploy/charts/* | test-rig/* | containers/* | compose.yml | \
      .devcontainer/* | .gitignore | LICENSE | renovate.json | \
      resources/release/*) ;;

    # neonfs_fuse's alerts_yml_test asserts on deploy/prometheus/alerts.yml.
    deploy/prometheus/*) mark neonfs_fuse ;;

    # The two scripts CI actually runs. `ci-affected` decides the whole
    # matrix, so a change to it has to exercise everything — including
    # itself. `ci-scrub-path-deps` runs inside three jobs.
    #
    # Listed before the inert rule below, and named individually rather than
    # by glob: "the rest of resources/scripts/ is inert" is the tempting
    # shape and the wrong one, because it would silently stop testing these
    # two.
    resources/scripts/ci-affected | resources/scripts/ci-scrub-path-deps)
      run_all=true
      ;;

    # `ci-install-k8s-tools` owns the csi-sanity pin the `neonfs_csi` job
    # builds and caches against, so a change to it does change that job's
    # result. The rest of what it installs (kind, kubectl, helm) is only
    # used by the nightly end-to-end workflow, which no PR triggers.
    resources/scripts/ci-install-k8s-tools) mark neonfs_csi ;;

    # Everything else in there is developer tooling — the `fj-*` forge
    # helpers, `neonfs-each`, `neonfs-release`, the container build script.
    # None is referenced by .forgejo/workflows/ci.yml, so none can change a
    # build result. They fell through to the catch-all, which sets
    # `run_vfs`, so editing a forge helper cost an hour on the Samba build
    # (#1565) with `canary` blocked behind it — the same trade already
    # rejected for `neonfs_client/*` below.
    resources/scripts/*) ;;

    # packaging/build-vfs-deb.sh drives the vfs_neonfs job; the rest of
    # packaging/ (nfpm configs, systemd units) isn't exercised by CI.
    packaging/*) mark vfs ;;

    # The C module sources feed the wire harness and the Samba build.
    neonfs_cifs/native/*) mark neonfs_cifs neonfs_omnibus wire vfs ;;

    # Every Elixir package depends on neonfs_client — but the two C jobs do
    # not. `vfs_neonfs` builds the Samba VFS module inside the distro's samba
    # source package and `vfs_neonfs_wire` runs a C harness; neither compiles
    # Elixir, and the contract they implement lives in `neonfs_cifs/native/`,
    # which has its own rule. Marking them here cost every neonfs_client PR an
    # hour on the Samba build for no coverage.
    neonfs_client/*) all_packages=true; mark integration cli ;;

    # test_support's build dep on core puts core on every consumer's path.
    neonfs_core/*)
      mark neonfs_core neonfs_fuse neonfs_docker neonfs_nfs neonfs_s3 \
        neonfs_webdav neonfs_omnibus integration
      ;;
    neonfs_test_support/*)
      mark neonfs_fuse neonfs_docker neonfs_nfs neonfs_s3 neonfs_webdav \
        integration
      ;;

    neonfs_fuse/*) mark neonfs_fuse neonfs_docker neonfs_omnibus ;;
    neonfs_docker/*) mark neonfs_docker neonfs_omnibus ;;
    neonfs_nfs/*) mark neonfs_nfs neonfs_omnibus ;;
    neonfs_webdav/*) mark neonfs_webdav neonfs_s3 neonfs_omnibus ;;
    neonfs_s3/*) mark neonfs_s3 neonfs_omnibus ;;
    neonfs_containerd/*) mark neonfs_containerd neonfs_omnibus integration ;;
    neonfs_csi/*) mark neonfs_csi ;;
    neonfs_cifs/*) mark neonfs_cifs neonfs_omnibus ;;
    neonfs_iam/*) mark neonfs_iam ;;
    neonfs_omnibus/*) mark neonfs_omnibus ;;
    neonfs_integration/*) mark integration ;;
    neonfs-cli/*) mark cli integration ;;

    # No pull request triggers this workflow — it runs on a schedule and on
    # demand — so editing it cannot change a PR's result. Falling through to
    # the catch-all would spend the two-hour Samba build proving that.
    .forgejo/workflows/e2e-nightly.yml) ;;

    # Unknown paths (.forgejo/, .tool-versions, resources/scripts/,
    # scripts/, …) affect shared infrastructure: run everything.
    *) run_all=true ;;
  esac
}

if [ "${1:-}" = "--all" ]; then
  run_all=true
else
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    classify "$path"
  done
fi

if $run_all; then
  packages=$(jq -c '[.[].name]' "$matrix_file")
  run_integration=true
  run_cli=true
  run_wire=true
  run_vfs=true
elif $all_packages; then
  # Every Elixir package, but the run_* flags stay as classify/1 left them.
  packages=$(jq -c '[.[].name]' "$matrix_file")
elif [ "${#affected[@]}" -eq 0 ]; then
  packages='[]'
else
  names=$(printf '%s\n' "${!affected[@]}" | jq -R . | jq -cs .)
  packages=$(jq -c --argjson names "$names" \
    '[.[].name | select(. as $n | $names | index($n))]' "$matrix_file")
fi

echo "packages=$packages"
echo "run_integration=$run_integration"
echo "run_cli=$run_cli"
echo "run_wire=$run_wire"
echo "run_vfs=$run_vfs"
