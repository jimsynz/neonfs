[Unit]
Description=NeonFS block device target (NBD server)
After=network.target
Wants=network.target
Documentation=https://neonfs.dev/docs

[Service]
Type=notify
User=neonfs
Group=neonfs
ExecStart=/usr/bin/neonfs-block-daemon start
ExecStop=/usr/bin/neonfs-block-daemon stop
Restart=on-failure
RestartSec=5
TimeoutStartSec=60
# Must exceed the in-flight drain deadline (~25s; see `:drain_deadline_ms` /
# `NEONFS_*_DRAIN_DEADLINE_MS`) plus headroom, else systemd SIGKILLs the BEAM
# mid-drain. Bump both together if either changes.
TimeoutStopSec=45

EnvironmentFile=-/etc/neonfs/neonfs.conf
EnvironmentFile=-/etc/neonfs/block.conf

RuntimeDirectory=neonfs
StateDirectory=neonfs

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# /var/lib/neonfs holds the TLS material shared with the core daemon.
ReadWritePaths=/var/lib/neonfs

[Install]
WantedBy=multi-user.target
