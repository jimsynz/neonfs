{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>project-neon/neonfs_workspace"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the pinned nfpm version in this repo's workflows",
      "managerFilePatterns": ["/\\.forgejo/workflows/[^/]+\\.yml$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\n\\s*\\w+=(?<currentValue>v\\S+)"
      ]
    }
  ]
}
